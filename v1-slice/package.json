{
  "name": "v1-slice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Framework v1 minimal slice: route + typed server function + auth guard + CSP + secret check",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "npm run build:client && npm run check:secrets",
    "build:client": "vite build",
    "check:secrets": "node scripts/check-secrets.js",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0",
    "express": "^4.19.2",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "typescript": "~5.6.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
