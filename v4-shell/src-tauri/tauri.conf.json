{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "v4-shell",
  "version": "0.1.0",
  "identifier": "com.framework.v4shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "v4-shell", "width": 800, "height": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self';"
    }
  },
  "bundle": { "active": false }
}
